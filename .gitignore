*.dylib
*.dll
*.so

*cronet*
/bin/*
!/bin/.gitkeep
# Transient cronet extraction staging dir (see CRONET_STAGE in Makefile). Only
# exists mid-build, but a failed run can leave it behind.
/bin.cronet-stage/
.build
.idea
cert
data
**/*.log
.DS_Store

**/*.syso
node_modules
*.db
*.json

# Golden sing-box configs. These MUST be tracked -- they are the reference the
# config tests compare against, so a fresh clone without them fails with
# "reading golden: no such file". The blanket *.json above (aimed at built
# configs and scratch files) would otherwise swallow them silently.
!v2/config/testdata/golden/*.json